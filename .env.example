# Copiar a .env (no se versiona) y cambiar las claves.
# SQL Server exige mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.

RABBITMQ_USER=citas
RABBITMQ_PASSWORD=Cambiar_Rabbit_1

MSSQL_SA_PASSWORD=Cambiar_Sa_Clave_1
CITAS_DB_PASSWORD=Cambiar_Citas_Clave_1
RECORDATORIOS_DB_PASSWORD=Cambiar_Record_Clave_1

# Offset fijo de Guatemala (sin horario de verano)
CLINIC_TZ_OFFSET=-06:00

# Recordatorio: 24 h antes de la cita. Para la demo, REMINDER_DEMO_DELAY_SECONDS > 0
# dispara el recordatorio N segundos después de agendar (0 = desactivado).
REMINDER_LEAD_MINUTES=1440
REMINDER_DEMO_DELAY_SECONDS=60
